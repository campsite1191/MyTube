diff --git a/cobalt/build/configs/android-arm/args.gn b/cobalt/build/configs/android-arm/args.gn
index 61f94d8..1fd8402 100644
--- a/cobalt/build/configs/android-arm/args.gn
+++ b/cobalt/build/configs/android-arm/args.gn
@@ -1,3 +1,16 @@
 import("//cobalt/build/configs/android_common.gn")
 
 target_cpu = "arm"
+
+# Target Hisense TV CPU (4x ARM Cortex-A73, ARMv8-A 32-bit).
+arm_version = 8
+arm_tune = "cortex-a73"
+
+# Required with arm_version = 8: Rust .rlib bitcode uses armv7-none-linux-android while C++ uses thumbv8a.
+use_thin_lto = false
+
+# Target Hisense Android TV OS directly (Android 12 / API 31), dropping legacy < API 31 compatibility.
+# Keep NDK C/C++ sysroot at API 29 so OpenSL ES (deprecated in API 30) compiles cleanly under -Werror.
+default_min_sdk_version = 31
+default_target_sdk_version = "31"
+android_ndk_api_level = 29
diff --git a/cobalt/build/configs/common.gn b/cobalt/build/configs/common.gn
index 6fcf0ca..3611edb 100644
--- a/cobalt/build/configs/common.gn
+++ b/cobalt/build/configs/common.gn
@@ -95,10 +95,12 @@ enable_rust_png = false
 enable_backup_ref_ptr_support = false
 enable_backup_ref_ptr_feature_flag = false
 
-# Disable vectorized HTML scanning (SIMD speedups for HTML parsing
-# are not needed).
-enable_vectorized_html_scanning = false
+# Enable vectorized HTML scanning (NEON SIMD speedup for HTML parsing).
+enable_vectorized_html_scanning = true
 
 # Disable Media Remoting (Casting / Remoter Mojo endpoints) for Cobalt.
 enable_media_remoting = false
 enable_media_remoting_rpc = false
+
+# Disable printing support.
+enable_printing = false
