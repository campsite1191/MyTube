+  if (IsA<HTMLDocument>(this) && domWindow() && IsInOutermostMainFrame()) {
+    const std::string host = Url().Host().Utf8();
+    if (host == "youtube.com" ||
+        (host.size() > 12 &&
+         host.compare(host.size() - 12, 12, ".youtube.com") == 0)) {
+      static const base::NoDestructor<std::string> kCachedUserScript([] {
+        std::string out;
+        base::MemoryMappedFile::Region region;
+        base::File asset_file(
+            base::android::OpenApkAsset("assets/userscript.js", &region));
+        if (asset_file.IsValid() && region.size > 0) {
+          base::MemoryMappedFile mapped;
+          if (mapped.Initialize(std::move(asset_file), region)) {
+            out.assign(reinterpret_cast<const char*>(mapped.data()),
+                       mapped.length());
+          }
+        }
+        return out;
+      }());
+      if (!kCachedUserScript->empty()) {
+        ClassicScript::CreateUnspecifiedScript(
+            String::FromUTF8(*kCachedUserScript),
+            ScriptSourceLocationType::kInternal,
+            SanitizeScriptErrors::kDoNotSanitize)
+            ->RunScript(domWindow());
+      }
+    }
+  }
