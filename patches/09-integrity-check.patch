+  private boolean verifyApkSignature() {
+    if (EXPECTED_SIGNING_SHA256.length() != 64) {
+      Log.w(TAG, "Signing SHA-256 not configured; skipping APK integrity check.");
+      return true;
+    }
+    try {
+      PackageManager pm = getPackageManager();
+      Signature[] signatures = null;
+      PackageInfo packageInfo =
+          pm.getPackageInfo(getPackageName(), PackageManager.GET_SIGNING_CERTIFICATES);
+      if (packageInfo.signingInfo != null) {
+        signatures = packageInfo.signingInfo.getApkContentsSigners();
+      }
+      if (signatures == null || signatures.length == 0) {
+        Log.e(TAG, "APK integrity check failed: no signing certificates found.");
+        return false;
+      }
+      MessageDigest md = MessageDigest.getInstance("SHA-256");
+      for (Signature signature : signatures) {
+        byte[] digest = md.digest(signature.toByteArray());
+        StringBuilder hex = new StringBuilder(digest.length * 2);
+        for (byte b : digest) {
+          hex.append(String.format(Locale.US, "%02X", b & 0xFF));
+        }
+        if (EXPECTED_SIGNING_SHA256.equalsIgnoreCase(hex.toString())) {
+          return true;
+        }
+      }
+      Log.e(TAG, "APK integrity check failed: signature mismatch.");
+      return false;
+    } catch (Exception e) {
+      Log.e(TAG, "APK integrity check failed with exception.", e);
+      return false;
+    }
+  }
+
   @Override
   protected void onCreate(Bundle savedInstanceState) {
     super.onCreate(savedInstanceState);
 
+    if (!verifyApkSignature()) {
+      finish();
+      return;
+    }
