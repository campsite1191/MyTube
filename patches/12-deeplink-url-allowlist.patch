+  @Override
+  protected void onNewIntent(Intent intent) {
+    super.onNewIntent(intent);
+    String deepLink = getIntentUrlAsString(intent);
+    if (deepLink.isEmpty()) {
+      return;
+    }
+    setIntent(intent);
+    BaseStarboardBridge bridge = getStarboardBridge();
+    if (bridge != null) {
+      bridge.handleDeepLink(deepLink);
+    }
+  }
+
+  @Override
+  protected String getIntentUrlAsString(Intent intent) {
+    if (intent == null) {
+      return "";
+    }
+    Uri intentUri = intent.getData();
+    if (intentUri == null) {
+      return "";
+    }
+    String scheme = intentUri.getScheme();
+    String host = intentUri.getHost();
+    int port = intentUri.getPort();
+    if (scheme == null
+        || !"https".equalsIgnoreCase(scheme)
+        || host == null
+        || intentUri.getUserInfo() != null
+        || (port != -1 && port != 443)) {
+      Log.w(TAG, "Blocked deep link with unsupported scheme, host, port, or userinfo.");
+      return "";
+    }
+    String lowerHost = host.toLowerCase(Locale.US);
+    if (!"youtube.com".equals(lowerHost)
+        && !"www.youtube.com".equals(lowerHost)
+        && !"m.youtube.com".equals(lowerHost)
+        && !"youtu.be".equals(lowerHost)) {
+      Log.w(TAG, "Blocked deep link with untrusted host.");
+      return "";
+    }
+    return intentUri.toString();
+  }
+
